  "ui_policy": {
    "grouping": "prefix_group first, then subcategory, then class/selector",
    "negative_order": [
      "Negative · Kill Switch",
      "Negative · Disabled",
      "Negative · Hide / Suppress",
      "Negative · Block / Deny"
    ],
    "runtime_rule": "Do not install hooks at startup. Scan and classify only when the user opens the runtime menu; install a hook only for explicit toggles."
  }
