{
  "target": "WAABPrefixCategories",
  "schema_version": 2,
  "purpose": "Curated prefix/subcategory taxonomy for the single Runtime browser. Used to keep WAABProperties and related runtime gates visually grouped by feature-family prefix, with negative gates split out first.",
  "generated_from": [
    {
      "source": "runtime logs",
      "notes": "WAContextMain/WAABProperties/PrivateExperimentation/DebugMenuSpy sessions"
    },
    {
      "source": "static review",
      "notes": "latest WhatsApp/SharedModules analysis notes; no binary hashes embedded in this taxonomy file"
    }
  ],
  "prefix_groups": [
    {
      "id": "waios",
      "title": "WAiOS",
      "match": [
        "waios_",
        "waio_",
        "maios_"
      ],
      "meaning": "WhatsApp iOS-specific experiments and platform toggles"
    },
    {
      "id": "wamo",
      "title": "WAMO",
      "match": [
        "wamo_"
      ],
      "meaning": "WhatsApp mobile / modular product experiments"
    },
    {
      "id": "xfamg",
      "title": "XFAMG",
      "match": [
        "xfamg_"
      ],
      "meaning": "Cross-family Meta graph/gating experiments"
    },
    {
      "id": "xwa",
      "title": "XWA",
      "match": [
        "xwa_"
      ],
      "meaning": "Cross-WhatsApp GraphQL/API model and feature gates"
    },
    {
      "id": "xma",
      "title": "XMA",
      "match": [
        "xma_"
